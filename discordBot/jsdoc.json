{
  "plugins": ["plugins/markdown"],
  "source": {
    "include": ["src", "scripts"],
    "includePattern": "\\.js$"
  },
  "opts": {
    "destination": "docs-api",
    "recurse": true,
    "readme": "../README.md",
    "encoding": "utf8"
  },
  "templates": {
    "default": {
      "outputSourceFiles": true
    }
  }
}
